theme_override_constants/outline_size = 3
theme_override_fonts/font = SubResource("SystemFont_cjk")
theme_override_font_sizes/font_size = 10
horizontal_alignment = 1

[node name="NoticeTimer" type="Timer" parent="HUD"]
wait_time = 2.0
one_shot = true

[node name="CraftingUI" parent="HUD" instance=ExtResource("32_crafting_ui")]
z_index = 20

[node name="DebugPanel" type="Control" parent="HUD"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("40_debug")


[node name="PauseMenu" parent="." instance=ExtResource("50_pause")]

[node name="VictoryScreen" parent="." instance=ExtResource("55_victory")]
